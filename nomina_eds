      var toastTimeout = null;
      function showToast(msg) {
        var el = document.getElementById("toast");
        el.textContent = msg;
        el.classList.remove("hide");
        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(function () {
          el.classList.add("hide");
        }, 2600);
      }

      function escapeHtml(str) {
        return String(str || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      /**
       * INICIALIZACIÓN Y EVENTOS
       */
      function bindEvents() {
        document.getElementById("inputYear").addEventListener("input", function (e) {
          var val = parseInt(e.target.value, 10);
          if (!isNaN(val) && val >= 1900 && val <= 2200) {
            appState.year = val;
            saveState();
            refreshUI();
          }
        });

        document.getElementById("btnYearDec").addEventListener("click", function () {
          if (appState.year > 1900) {
            appState.year--;
            saveState();
            refreshUI();
          }
        });

        document.getElementById("btnYearInc").addEventListener("click", function () {
          if (appState.year < 2200) {
            appState.year++;
            saveState();
            refreshUI();
          }
        });

        document.getElementById("selectMonth").addEventListener("change", function (e) {
          appState.month = parseInt(e.target.value, 10) || 0;
          saveState();
          refreshUI();
        });

        document.getElementById("btnMonthDec").addEventListener("click", function () {
          if (appState.month === 0) {
            appState.month = 11;
            appState.year--;
          } else {
            appState.month--;
          }
          saveState();
          refreshUI();
        });

        document.getElementById("btnMonthInc").addEventListener("click", function () {
          if (appState.month === 11) {
            appState.month = 0;
            appState.year++;
          } else {
            appState.month++;
          }
          saveState();
          refreshUI();
        });

        document.getElementById("selectStaffFilter").addEventListener("change", function (e) {
          appState.staffFilter = e.target.value;
          saveState();
          refreshUI();
        });

        document.getElementById("tabSheet").addEventListener("click", function () {
          appState.activeTab = "sheet";
          saveState();
          refreshUI();
        });

        document.getElementById("tabAnnual").addEventListener("click", function () {
          appState.activeTab = "annual";
          saveState();
          refreshUI();
        });

        document.getElementById("tabLog").addEventListener("click", function () {
          appState.activeTab = "log";
          saveState();
          refreshUI();
