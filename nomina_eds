<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="theme-color" content="#0284c7" />
  <title>Calendario Anual de Turnos Rotativos (DD-NN-RR)</title>
  <style>
    :root {
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --bg-muted: #f1f5f9;
      --border-light: #e2e8f0;
      --border-med: #cbd5e1;
      --text-main: #0f172a;
      --text-sec: #475569;
      --text-muted: #64748b;
      --sky-600: #0284c7;
      --sky-700: #0369a1;
      --sky-100: #e0f2fe;
      --sky-50: #f0f9ff;
      --indigo-600: #4f46e5;
      --indigo-100: #e0e7ff;
      --emerald-600: #059669;
      --emerald-100: #d1fae5;
      --amber-500: #f59e0b;
      --amber-600: #d97706;
      --amber-100: #fef3c7;
      --purple-600: #9333ea;
      --purple-100: #f3e8ff;
      --rose-600: #e11d48;
      --rose-100: #ffe4e6;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.4;
      padding-bottom: calc(24px + var(--safe-bottom));
      -webkit-text-size-adjust: 100%;
    }

    button, input, select, textarea {
      font-family: inherit;
      touch-action: manipulation;
    }

    @media screen and (max-width: 768px) {
      input, select, textarea {
        font-size: 16px !important;
      }
    }

    .container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 16px;
    }

    /* Header */
    .app-header {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-light);
      position: sticky;
      top: 0;
      z-index: 30;
      padding-top: var(--safe-top);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .header-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--sky-600);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-title-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
    }

    .brand-title span {
      color: var(--sky-600);
    }

    .pill-tag {
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      background: var(--sky-50);
      color: var(--sky-700);
      border: 1px solid #bae6fd;
    }

    .brand-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .header-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    /* Botones */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      border: 1px solid transparent;
      cursor: pointer;
      transition: background-color 0.15s, transform 0.05s;
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-sky { background: var(--sky-600); color: #fff; }
    .btn-sky:hover { background: var(--sky-700); }

    .btn-amber { background: var(--amber-500); color: #fff; }
    .btn-amber:hover { background: var(--amber-600); }

    .btn-emerald { background: var(--emerald-600); color: #fff; }
    .btn-emerald:hover { background: #047857; }

    .btn-dark { background: #1e293b; color: #fff; }
    .btn-dark:hover { background: #0f172a; }

    .btn-rose-soft { background: #fff1f2; color: var(--rose-600); border-color: #fecdd3; }
    .btn-rose-soft:hover { background: var(--rose-100); }

    .btn-ghost { background: #fff; color: var(--text-sec); border-color: var(--border-med); }
    .btn-ghost:hover { background: var(--bg-muted); }

    /* Main Layout */
    .main-content {
      padding-top: 18px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* Panel de Controles */
    .panel {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      padding: 16px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    }

    .controls-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      align-items: end;
    }

    @media (max-width: 1024px) {
      .controls-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .controls-grid {
        grid-template-columns: 1fr;
      }
    }

    .control-label {
      display: block;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .stepper-box {
      display: flex;
      align-items: center;
      background: var(--bg-page);
      border: 1px solid var(--border-med);
      border-radius: 12px;
      padding: 3px;
      height: 42px;
    }

    .stepper-btn {
      width: 36px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid var(--border-light);
      background: #fff;
      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .stepper-btn:hover { background: var(--bg-muted); }

    .stepper-input {
      width: 100%;
      border: none;
      background: transparent;
      text-align: center;
      font-size: 16px;
      font-weight: 800;
      color: var(--text-main);
      outline: none;
    }

    .month-row {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-arrow {
      width: 38px;
      height: 42px;
      border-radius: 12px;
      border: 1px solid var(--border-med);
      background: #fff;
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
      cursor: pointer;
      flex-shrink: 0;
    }

    .nav-arrow:hover { background: var(--bg-muted); }

    .field-select, .field-input {
      width: 100%;
      height: 42px;
      padding: 0 12px;
      border-radius: 12px;
      border: 1px solid var(--border-med);
      background: #fff;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
      outline: none;
    }

    .field-select:focus, .field-input:focus {
      border-color: var(--sky-600);
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .tabs-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: var(--bg-muted);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 3px;
      height: 42px;
    }

    .tab-btn {
      border: none;
      background: transparent;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-sec);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }

    .tab-btn.active {
      background: #fff;
      color: var(--text-main);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    }

    .badge-count {
      background: var(--amber-500);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      padding: 1px 6px;
      border-radius: 999px;
    }

    /* Barra secundaria: Fecha de corte y Convenciones */
    .sub-bar {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid var(--border-light);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-size: 12px;
    }

    .cutoff-box {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      background: var(--sky-50);
      border: 1px solid #bae6fd;
      padding: 6px 12px;
      border-radius: 12px;
    }

    .dot-pulse {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--sky-600);
      display: inline-block;
    }

    .cutoff-date-input {
      height: 32px;
      padding: 0 8px;
      border-radius: 8px;
      border: 1px solid #7dd3fc;
      background: #fff;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-main);
    }

    .btn-mini {
      padding: 4px 10px;
      border-radius: 8px;
      border: 1px solid #7dd3fc;
      background: #fff;
      color: var(--sky-700);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-mini:hover { background: var(--sky-100); }

    .legend-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }

    .leg-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 9px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      border: 1px solid transparent;
    }

    .leg-d { background: var(--sky-100); color: #0c4a6e; border-color: #bae6fd; }
    .leg-n { background: var(--indigo-100); color: #312e81; border-color: #c7d2fe; }
    .leg-r { background: var(--emerald-100); color: #064e3b; border-color: #a7f3d0; }
    .leg-p { background: var(--amber-100); color: #78350f; border-color: #fde68a; }
    .leg-s { background: var(--purple-100); color: #581c87; border-color: #e9d5ff; }

    /* Tabla Sábana Mensual */
    .sheet-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .sheet-banner {
      background: #0f172a;
      color: #fff;
      padding: 14px 18px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .sheet-banner h2 {
      font-size: 16px;
      font-weight: 800;
    }

    .sheet-banner h2 span {
      color: #38bdf8;
    }

    .sheet-banner p {
      font-size: 12px;
      color: #cbd5e1;
      margin-top: 2px;
    }

    .table-scroll {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .sheet-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      text-align: left;
    }

    .sheet-table th, .sheet-table td {
      border-bottom: 1px solid var(--border-light);
      border-right: 1px solid var(--border-light);
    }

    .sticky-col {
      position: -webkit-sticky;
      position: sticky;
      left: 0;
      z-index: 12;
      background: #fff;
      min-width: 215px;
      max-width: 230px;
      padding: 10px 14px;
      border-right: 1px solid var(--border-med) !important;
      box-shadow: 2px 0 6px rgba(15, 23, 42, 0.05);
    }

    .sheet-table thead .sticky-col {
      z-index: 20;
      background: var(--bg-muted);
      font-weight: 800;
      color: var(--text-sec);
    }

    .day-th {
      min-width: 58px;
      padding: 7px 4px;
      text-align: center;
      background: var(--bg-muted);
      color: var(--text-sec);
    }

    .day-th.weekend {
      background: #fff1f2;
      color: #be123c;
    }

    .day-th.is-today {
      background: var(--sky-600) !important;
      color: #fff !important;
    }

    .day-th.is-future {
      opacity: 0.72;
    }

    .day-th-name {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .day-th-num {
      font-size: 14px;
      font-weight: 800;
    }

    .staff-name-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .staff-name-txt {
      font-size: 14px;
      font-weight: 800;
      color: var(--text-main);
    }

    .role-badge {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 6px;
    }

    .role-titular { background: var(--sky-100); color: var(--sky-700); }
    .role-suplente { background: var(--purple-100); color: #6b21a8; }

    .inline-controls {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 6px;
    }

    .mini-date {
      height: 27px;
      padding: 0 5px;
      border-radius: 7px;
      border: 1px solid var(--border-med);
      background: var(--bg-page);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-main);
      width: 118px;
    }

    .mini-seed {
      height: 27px;
      padding: 0 5px;
      border-radius: 7px;
      border: 1px solid #7dd3fc;
      background: var(--sky-50);
      font-size: 11px;
      font-weight: 800;
      color: #0369a1;
      cursor: pointer;
    }

    .day-cell {
      padding: 6px 4px;
      text-align: center;
      vertical-align: middle;
      cursor: pointer;
      transition: background-color 0.12s;
      user-select: none;
    }

    .day-cell:hover {
      background-color: #f0f9ff;
    }

    .day-cell.is-today {
      background-color: rgba(2, 132, 199, 0.08);
      box-shadow: inset 0 0 0 2px var(--sky-600);
    }

    .day-cell.is-future {
      opacity: 0.56;
    }

    .shift-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 30px;
      height: 25px;
      padding: 0 6px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 800;
      border: 1px solid transparent;
    }

    .pill-d { background: var(--sky-100); color: #0c4a6e; border-color: #7dd3fc; }
    .pill-n { background: var(--indigo-600); color: #fff; border-color: #4338ca; }
    .pill-r { background: var(--emerald-100); color: #065f46; border-color: #6ee7b7; }
    .pill-free { background: #fff; color: #94a3b8; border: 1px dashed var(--border-med); }
    .pill-abs-cov { background: var(--amber-100); color: #78350f; border-color: #f59e0b; text-decoration: line-through; }
    .pill-abs-uncov { background: var(--rose-100); color: #881337; border-color: #fb7185; text-decoration: line-through; }
    .pill-sup { background: var(--purple-600); color: #fff; border-color: #7e22ce; }

    .cell-sub {
      font-size: 9px;
      font-weight: 700;
      margin-top: 2px;
      max-width: 56px;
      margin-left: auto;
      margin-right: auto;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--text-muted);
    }

    /* Tarjetas Inferiores de Resumen por Funcionario */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 1024px) {
      .cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }
    }

    .summary-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    }

    .card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }

    .card-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card-name {
      font-size: 16px;
      font-weight: 800;
      color: var(--text-main);
    }

    .card-meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 3px;
    }

    .card-period-tag {
      display: inline-block;
      margin-top: 6px;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
    }

    .tag-cutoff { background: var(--sky-100); color: #0369a1; }
    .tag-closed { background: var(--emerald-100); color: #065f46; }
    .tag-future { background: var(--bg-muted); color: var(--text-sec); }

    .metrics-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      padding-top: 10px;
      border-top: 1px solid var(--border-light);
      text-align: center;
    }

    .metric-box {
      padding: 8px 4px;
      border-radius: 12px;
      border: 1px solid transparent;
    }

    .m-d { background: #f0f9ff; border-color: #e0f2fe; color: #0369a1; }
    .m-n { background: #eef2ff; border-color: #e0e7ff; color: #3730a3; }
    .m-r { background: #ecfdf5; border-color: #d1fae5; color: #065f46; }
    .m-p { background: #fffbeb; border-color: #fef3c7; color: #92400e; }

    .metric-lbl {
      font-size: 11px;
      font-weight: 700;
    }

    .metric-val {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
      margin-top: 2px;
    }

    .card-footer-line {
      padding-top: 8px;
      border-top: 1px dashed var(--border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: var(--text-sec);
    }

    /* Vista 12 Meses */
    .annual-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 1024px) {
      .annual-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 640px) {
      .annual-grid { grid-template-columns: 1fr; }
    }

    .month-card {
      background: #fff;
      border: 1px solid var(--border-light);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .month-card-head {
      background: #0f172a;
      color: #fff;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .month-card-body {
      max-height: 380px;
      overflow-y: auto;
    }

    .annual-day-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 6px 12px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 12px;
    }

    .annual-day-row.weekend { background: #fafafa; }

    .annual-pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 4px;
    }

    .mini-chip {
      padding: 2px 7px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      border: 1px solid transparent;
      cursor: pointer;
    }

    /* Tablas Bitácora y Reportes */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }

    .data-table th {
      background: var(--bg-muted);
      color: var(--text-sec);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-med);
    }

    .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-light);
    }

    /* Modales */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 50;
    }

    .modal-box {
      background: #fff;
      border-radius: 18px;
      width: 100%;
      max-width: 760px;
      max-height: 92vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.25);
    }

    .modal-box.sm { max-width: 520px; }
    .modal-box.lg { max-width: 920px; }

    .modal-head {
      background: #0f172a;
      color: #fff;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-close {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: none;
      background: #1e293b;
