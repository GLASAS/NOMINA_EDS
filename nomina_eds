        }
        document.getElementById("paySummaryBody").innerHTML = sHtml;

        var nHtml = "";
        if (data.novelties.length === 0) {
          nHtml = '<tr><td colspan="7" style="text-align:center;padding:16px;color:#64748b;">Sin novedades registradas en este rango.</td></tr>';
        } else {
