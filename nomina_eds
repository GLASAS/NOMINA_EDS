      /**
       * RENDERIZADO VISTA 3: BITÁCORA DE NOVEDADES
       */
      function renderLogView() {
        var tbody = document.getElementById("logTableBody");
        var staffMap = {};
        for (var i = 0; i < appState.staff.length; i++) {
          staffMap[appState.staff[i].id] = appState.staff[i];
        }

        var sorted = appState.novelties.slice().sort(function (a, b) {
          return a.date.localeCompare(b.date);
        });

        if (sorted.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:24px;color:#64748b;">No hay novedades registradas todavía.</td></tr>';
          return;
        }

        var rows = "";
        for (var j = 0; j < sorted.length; j++) {
          var nv = sorted[j];
          var person = staffMap[nv.staffId];
          var pDate = parseISO(nv.date);
          var baseShift = person && person.role === "titular" ? getTitularBaseShift(person, pDate.y, pDate.m, pDate.d) : "—";
          var sup = nv.substituteId ? staffMap[nv.substituteId] : null;

          var detailTxt = "—";
          if (nv.kind === "ABSENCE") {
            detailTxt = sup ? "Suplente: " + sup.name : "Sin suplente";
          } else if (nv.kind === "MANUAL_SHIFT") {
            detailTxt = "Turno " + nv.manualShift + (sup ? " (Cubre a " + sup.name + ")" : "");
          } else if (nv.kind === "SHIFT_OVERRIDE") {
            detailTxt = "Cambio a " + nv.manualShift;
          }

          rows += "<tr>";
          rows += "<td><strong>" + nv.date + "</strong></td>";
          rows += "<td>" + getNompropioDay(pDate.y, pDate.m, pDate.d) + "</td>";
          rows += "<td><strong>" + (person ? escapeHtml(person.name) : "Eliminado") + "</strong></td>";
          rows += "<td>" + (baseShift || "—") + "</td>";
          rows += "<td><span class='leg-item leg-p'>" + escapeHtml(nv.type) + "</span></td>";
          rows += "<td><strong>" + escapeHtml(detailTxt) + "</strong></td>";
          rows += "<td>" + escapeHtml(nv.note || "—") + "</td>";
          rows += '<td class="no-print"><button type="button" class="btn btn-rose-soft" style="padding:4px 8px;font-size:11px;" data-del-nov="' + nv.id + '">Eliminar</button></td>';
          rows += "</tr>";
        }
        tbody.innerHTML = rows;
      }

      /**
       * MODAL DE NOVEDADES Y SUPLENTE
       */
      function openNoveltyModal(staffId, dateISO) {
        var selStaff = document.getElementById("novStaffSel");
        var opts = "";
        for (var i = 0; i < appState.staff.length; i++) {
          var s = appState.staff[i];
          opts += '<option value="' + s.id + '">' + escapeHtml(s.name) + " (" + (s.role === "titular" ? "Titular" : "Suplente") + ")</option>";
        }
        selStaff.innerHTML = opts;
        selStaff.value = staffId || (appState.staff[0] ? appState.staff[0].id : "");

        var targetDate = dateISO || formatISO(appState.year, appState.month, 1);
        document.getElementById("novDateStart").value = targetDate;
