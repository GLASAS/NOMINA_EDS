          var sid = document.getElementById("novStaffSel").value;
          var p = null;
          for (var i = 0; i < appState.staff.length; i++) {
            if (appState.staff[i].id === sid) p = appState.staff[i];
          }
          updateNoveltyModalVisibility(p, document.getElementById("novDateStart").value);
        });

        document.getElementById("formNovelty").addEventListener("submit", function (e) {
          e.preventDefault();
          var staffId = document.getElementById("novStaffSel").value;
          var startISO = document.getElementById("novDateStart").value;
          var endISO = document.getElementById("novDateEnd").value || startISO;
          var note = document.getElementById("novNoteInp").value.trim();

          var person = null;
          for (var i = 0; i < appState.staff.length; i++) {
            if (appState.staff[i].id === staffId) person = appState.staff[i];
          }
          if (!person || !startISO) return;

          var sp = parseISO(startISO);
          var ep = parseISO(endISO);
          var daysSpan = Math.max(0, Math.min(366, diffDaysUTC(ep.y, ep.m, ep.d, sp.y, sp.m, sp.d)));

          for (var offset = 0; offset <= daysSpan; offset++) {
            var curISO = addDaysISO(startISO, offset);
            appState.novelties = appState.novelties.filter(function (n) {
              return !(n.staffId === staffId && n.date === curISO);
            });

            if (person.role === "suplente") {
              var supShift = document.getElementById("novSupShiftSel").value;
              var covId = document.getElementById("novSupCoverSel").value;
              if (supShift !== "LIBRE") {
                appState.novelties.push({
                  id: "nv_" + Date.now() + "_" + offset,
                  staffId: staffId,
                  date: curISO,
                  kind: "MANUAL_SHIFT",
                  type: "Turno Manual",
                  substituteId: covId,
                  manualShift: supShift,
                  note: note
                });
              }
            } else {
              var tVal = document.getElementById("novTypeSel").value;
              if (tVal === "CAMBIO_TURNO") {
                appState.novelties.push({
                  id: "nv_" + Date.now() + "_" + offset,
                  staffId: staffId,
                  date: curISO,
                  kind: "SHIFT_OVERRIDE",
                  type: "CAMBIO_TURNO",
                  substituteId: "",
                  manualShift: document.getElementById("novTitularShiftSel").value,
                  note: note
                });
              } else if (tVal !== "NORMAL") {
                appState.novelties.push({
                  id: "nv_" + Date.now() + "_" + offset,
                  staffId: staffId,
                  date: curISO,
                  kind: "ABSENCE",
                  type: tVal,
                  substituteId: document.getElementById("novSubSel").value,
                  manualShift: "",
                  note: note
                });
              }
            }
          }

          saveState();
          document.getElementById("modalNovelty").classList.add("hidden");
          refreshUI();
          showToast("Programación actualizada");
        });

        document.getElementById("btnDeleteNovelty").addEventListener("click", function () {
          var staffId = document.getElementById("novStaffSel").value;
          var dISO = document.getElementById("novDateStart").value;
          appState.novelties = appState.novelties.filter(function (n) {
            return !(n.staffId === staffId && n.date === dISO);
          });
          saveState();
          document.getElementById("modalNovelty").classList.add("hidden");
          refreshUI();
          showToast("Registro eliminado");
        });

        // Modal Nómina CSV
        document.getElementById("btnOpenPayroll").addEventListener("click", function () {
          var sel = document.getElementById("payStaffSel");
          var opts = '<option value="ALL">Todos los funcionarios (' + appState.staff.length + ")</option>";
          for (var i = 0; i < appState.staff.length; i++) {
            opts += '<option value="' + appState.staff[i].id + '">' + escapeHtml(appState.staff[i].name) + "</option>";
          }
          sel.innerHTML = opts;
          sel.value = appState.staffFilter;

          var cp = parseISO(appState.cutoffDate);
          if (appState.year === cp.y && appState.month === cp.m) {
            applyPayrollPreset("CURRENT_TODAY");
          } else {
            applyPayrollPreset("SELECTED_MONTH");
          }
          document.getElementById("modalPayroll").classList.remove("hidden");
        });

        document.getElementById("btnClosePayroll").addEventListener("click", function () {
          document.getElementById("modalPayroll").classList.add("hidden");
        });

        document.getElementById("payStartInp").addEventListener("change", renderPayrollPreview);
        document.getElementById("payEndInp").addEventListener("change", renderPayrollPreview);
        document.getElementById("payStaffSel").addEventListener("change", renderPayrollPreview);

        document.getElementById("btnDownloadNoveltiesCSV").addEventListener("click", function () {
          var d = buildPayrollData();
          var csv = "Periodo Desde;Periodo Hasta;Fecha;Dia Semana;Funcionario;Turno Base;Tipo Novedad;Suplente / Turno Asignado;Observacion\n";
          if (d.novelties.length === 0) {
            csv += d.startISO + ";" + d.endISO + ";Sin novedades en este periodo;;;;;;\n";
          } else {
            for (var i = 0; i < d.novelties.length; i++) {
              var n = d.novelties[i];
              var cleanObs = String(n.obs || "").replace(/;/g, ",").replace(/\r?\n/g, " ");
              csv += d.startISO + ";" + d.endISO + ";" + n.date + ";" + n.dayName + ";" + n.funcionario + ";" + n.baseShift + ";" + n.tipo + ";" + n.suplente + ";" + cleanObs + "\n";
            }
          }
          triggerCSVDownload(csv, "Nomina_Novedades_" + d.startISO + "_a_" + d.endISO + ".csv");
          showToast("CSV de Novedades descargado");
        });

        document.getElementById("btnDownloadSummaryCSV").addEventListener("click", function () {
          var d = buildPayrollData();
          var csv = "Periodo Desde;Periodo Hasta;Dias Evaluados;Funcionario;Rol;Dias (D);Noches (N);Descansos (R);Total Laborados (D+N);Permisos y Licencias;Vacaciones;Incapacidades;Turnos Cubiertos Suplente\n";
          for (var i = 0; i < d.summaries.length; i++) {
            var r = d.summaries[i];
            var m = r.metrics;
            csv += d.startISO + ";" + d.endISO + ";" + d.daysCount + ";" + r.person.name + ";" + r.person.role + ";" + m.cD + ";" + m.cN + ";" + m.cR + ";" + m.worked + ";" + m.permisos + ";" + m.vacaciones + ";" + m.incapacidades + ";" + m.suplencias + "\n";
          }
          triggerCSVDownload(csv, "Nomina_Consolidado_" + d.startISO + "_a_" + d.endISO + ".csv");
          showToast("CSV Consolidado descargado");
        });

        // Imprimir y Reiniciar
        document.getElementById("btnPrint").addEventListener("click", function () {
          window.print();
        });

        document.getElementById("btnResetAll").addEventListener("click", function () {
          appState = getDefaultState();
          saveState();
          refreshUI();
          showToast("Datos iniciales restaurados (Danilo, Vicente, STEFANY, ANDRES)");
        });
      }

      function init() {
        try {
          appState = loadState();
          bindEvents();
          refreshUI();
        } catch (err) {
          appState = getDefaultState();
          saveState();
          bindEvents();
          refreshUI();
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</body>
</html>
