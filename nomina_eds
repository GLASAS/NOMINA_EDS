          for (var i = 0; i < raw.staff.length; i++) {
            var item = raw.staff[i];
            if (item && typeof item.name === "string" && item.name.trim() !== "") {
              var roleNorm = String(item.role || "").toLowerCase() === "suplente" ? "suplente" : "titular";
              var seedNorm = SEMILLAS_VALIDAS.indexOf(String(item.seed || "").toUpperCase()) !== -1
                ? String(item.seed).toUpperCase()
                : (roleNorm === "suplente" ? "NONE" : "RD");
              staffList.push({
                id: String(item.id || ("st_" + i + "_" + Date.now())),
                name: item.name.trim(),
                role: roleNorm,
                startDate: /^\d{4}-\d{2}-\d{2}$/.test(String(item.startDate || "")) ? item.startDate : "2026-11-01",
                seed: roleNorm === "suplente" ? "NONE" : seedNorm
              });
            }
          }
        }
        if (staffList.length === 0) staffList = def.staff;

        var novList = [];
        if (Array.isArray(raw.novelties)) {
          for (var j = 0; j < raw.novelties.length; j++) {
            var nv = raw.novelties[j];
            if (nv && nv.staffId && /^\d{4}-\d{2}-\d{2}$/.test(String(nv.date || ""))) {
              novList.push(nv);
            }
          }
        }

        return {
          year: validYear,
          month: validMonth,
          cutoffDate: validCutoff,
          staffFilter: raw.staffFilter || "ALL",
          activeTab: ["sheet", "annual", "log"].indexOf(raw.activeTab) !== -1 ? raw.activeTab : "sheet",
          staff: staffList,
          novelties: novList
        };
      }

      function loadState() {
        try {
          var raw = window.localStorage.getItem(STORAGE_KEY);
          if (raw) {
            return sanitizeState(JSON.parse(raw));
          }
        } catch (e) {
          if (memoryStore) return sanitizeState(memoryStore);
        }
        return getDefaultState();
      }

      function saveState() {
        memoryStore = JSON.parse(JSON.stringify(appState));
        try {
          window.localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
        } catch (e) {
          // Respaldo silencioso en memoria para Safari modo privado
        }
      }

      /**
       * Regla Excel exacta hacia adelante:
       * =+SI(B4&C4="DD";"N";SI(B4&C4="DN";"N";SI(B4&C4="NN";"R";SI(B4&C4="NR";"R";SI(B4&C4="RR";"D";SI(B4&C4="RD";"D";""))))))
       */
      function nextShiftForward(prev2, prev1) {
        var pair = prev2 + prev1;
        if (pair === "DD") return "N";
        if (pair === "DN") return "N";
        if (pair === "NN") return "R";
        if (pair === "NR") return "R";
        if (pair === "RR") return "D";
        if (pair === "RD") return "D";
        return "D";
      }

      /**
       * Regla inversa determinista hacia atrás:
       * Si día t es cur0 y día t+1 es cur1, deduce día t-1:
       * RD->D => anterior fue R (RR->D)
       * DD->N => anterior fue R (RD->D)
       * DN->N => anterior fue D (DD->N)
       * NN->R => anterior fue D (DN->N)
       * NR->R => anterior fue N (NN->R)
       * RR->D => anterior fue N (NR->R)
       */
      function prevShiftBackward(cur0, cur1) {
        var pair = cur0 + cur1;
        if (pair === "RD") return "R";
        if (pair === "DD") return "R";
        if (pair === "DN") return "D";
        if (pair === "NN") return "D";
        if (pair === "NR") return "N";
        if (pair === "RR") return "N";
        return "R";
      }

      function parseISO(isoStr) {
        var parts = String(isoStr || "2026-11-01").split("-");
        return {
          y: parseInt(parts[0], 10) || 2026,
          m: (parseInt(parts[1], 10) || 11) - 1,
          d: parseInt(parts[2], 10) || 1
        };
      }

      function formatISO(y, m, d) {
        var mm = m + 1 < 10 ? "0" + (m + 1) : String(m + 1);
        var dd = d < 10 ? "0" + d : String(d);
        return y + "-" + mm + "-" + dd;
      }

      function diffDaysUTC(y1, m1, d1, y2, m2, d2) {
        var u1 = Date.UTC(y1, m1, d1);
        var u2 = Date.UTC(y2, m2, d2);
        return Math.round((u1 - u2) / 86400000);
      }

      function addDaysISO(isoStr, delta) {
        var p = parseISO(isoStr);
        var dt = new Date(Date.UTC(p.y, p.m, p.d + delta));
        return formatISO(dt.getUTCFullYear(), dt.getUTCMonth(), dt.getUTCDate());
      }

      function isLeapYear(y) {
        return (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
      }

      function getNompropioDay(y, m, d) {
        var dt = new Date(y, m, d);
        return DIAS_NOMPROPIO[dt.getDay()];
      }

      /**
       * Calcula el turno programado DD-NN-RR para cualquier fecha (futura o pasada)
       */
      function getTitularBaseShift(person, y, m, d) {
        if (!person || person.role === "suplente") return "";
        var st = parseISO(person.startDate);
        var diff = diffDaysUTC(y, m, d, st.y, st.m, st.d);
        var seed = SEMILLAS_VALIDAS.indexOf(person.seed) !== -1 ? person.seed : "RD";
        var s0 = seed.charAt(0);
        var s1 = seed.charAt(1);

        if (diff === 0) return s0;
        if (diff === 1) return s1;

        if (diff > 1) {
          var p2 = s0;
          var p1 = s1;
          var cur = s1;
          for (var i = 2; i <= diff; i++) {
            cur = nextShiftForward(p2, p1);
            p2 = p1;
            p1 = cur;
          }
          return cur;
        } else {
          var c0 = s0;
          var c1 = s1;
          var prev = s0;
          for (var step = -1; step >= diff; step--) {
            prev = prevShiftBackward(c0, c1);
            c1 = c0;
            c0 = prev;
          }
          return prev;
        }
      }

      /**
       * Evalúa el estado completo de un funcionario en una fecha específica
       */
      function getDayCellInfo(person, dateISO) {
        var p = parseISO(dateISO);
        var baseShift = getTitularBaseShift(person, p.y, p.m, p.d);
        var staffMap = {};
        for (var i = 0; i < appState.staff.length; i++) {
          staffMap[appState.staff[i].id] = appState.staff[i];
        }

        var ownNov = null;
        var coveringNov = null;
        for (var j = 0; j < appState.novelties.length; j++) {
          var n = appState.novelties[j];
          if (n.date === dateISO) {
            if (n.staffId === person.id) ownNov = n;
            if (n.kind === "ABSENCE" && n.substituteId === person.id) coveringNov = n;
          }
        }

        if (person.role === "suplente") {
          if (ownNov && ownNov.kind === "MANUAL_SHIFT" && ownNov.manualShift && ownNov.manualShift !== "LIBRE") {
            var covTit = ownNov.substituteId ? staffMap[ownNov.substituteId] : null;
            return {
              baseShift: "",
              effectiveShift: ownNov.manualShift,
              badge: ownNov.manualShift,
              subText: covTit ? "Cub. " + covTit.name : "Manual",
              pillClass: "pill-sup",
              isAbsence: false,
              isCovering: true,
              nov: ownNov
            };
          }
          if (coveringNov) {
            var absTit = staffMap[coveringNov.staffId];
            var shiftToCover = absTit ? getTitularBaseShift(absTit, p.y, p.m, p.d) : "D";
            return {
              baseShift: "",
              effectiveShift: shiftToCover || "D",
              badge: shiftToCover || "D",
              subText: absTit ? "Cub. " + absTit.name : "Supl.",
              pillClass: "pill-sup",
              isAbsence: false,
              isCovering: true,
              nov: coveringNov
            };
          }
          return {
            baseShift: "",
            effectiveShift: "",
            badge: "—",
            subText: "Libre",
            pillClass: "pill-free",
            isAbsence: false,
            isCovering: false,
            nov: null
          };
        }

        // Funcionario Titular
        if (ownNov) {
          if (ownNov.kind === "SHIFT_OVERRIDE" && ownNov.manualShift) {
            return {
              baseShift: baseShift,
              effectiveShift: ownNov.manualShift,
              badge: ownNov.manualShift,
              subText: "Cambio",
              pillClass: ownNov.manualShift === "D" ? "pill-d" : (ownNov.manualShift === "N" ? "pill-n" : "pill-r"),
              isAbsence: false,
              isCovering: false,
              nov: ownNov
            };
          }
          if (ownNov.kind === "ABSENCE") {
            var sup = ownNov.substituteId ? staffMap[ownNov.substituteId] : null;
            return {
              baseShift: baseShift,
              effectiveShift: "",
              badge: baseShift || "AUS",
              subText: sup ? "Sup: " + sup.name : ownNov.type,
              pillClass: sup ? "pill-abs-cov" : "pill-abs-uncov",
              isAbsence: true,
              isCovering: false,
              nov: ownNov
            };
          }
        }

        var pClass = baseShift === "D" ? "pill-d" : (baseShift === "N" ? "pill-n" : "pill-r");
        return {
          baseShift: baseShift,
          effectiveShift: baseShift,
          badge: baseShift,
          subText: "",
          pillClass: pClass,
          isAbsence: false,
          isCovering: false,
          nov: null
        };
      }

      /**
       * Calcula métricas acumuladas en un rango [startISO, endISO]
       */
      function calculatePeriodMetrics(person, startISO, endISO) {
        var sp = parseISO(startISO);
        var ep = parseISO(endISO);
        var diff = diffDaysUTC(ep.y, ep.m, ep.d, sp.y, sp.m, sp.d);
        var res = {
          cD: 0,
          cN: 0,
          cR: 0,
          worked: 0,
          permisos: 0,
          vacaciones: 0,
          incapacidades: 0,
          totalNov: 0,
          suplencias: 0
        };
        if (diff < 0) return res;

        for (var i = 0; i <= diff; i++) {
          var dISO = addDaysISO(startISO, i);
          var info = getDayCellInfo(person, dISO);
          if (person.role === "suplente") {
            if (info.effectiveShift === "D") res.cD++;
            if (info.effectiveShift === "N") res.cN++;
            if (info.effectiveShift === "R") res.cR++;
            if (info.isCovering) res.suplencias++;
          } else {
            if (info.isAbsence) {
              res.totalNov++;
              var t = info.nov ? info.nov.type : "PERMISO";
              if (t === "VACACIONES") res.vacaciones++;
              else if (t === "INCAPACIDAD") res.incapacidades++;
              else res.permisos++;
            } else {
              if (info.effectiveShift === "D") res.cD++;
              if (info.effectiveShift === "N") res.cN++;
              if (info.effectiveShift === "R") res.cR++;
            }
          }
        }
        res.worked = res.cD + res.cN;
        return res;
      }

      function getFilteredStaff() {
        if (appState.staffFilter === "ALL") return appState.staff;
        return appState.staff.filter(function (s) { return s.id === appState.staffFilter; });
      }

      /**
       * RENDERIZADO VISTA 1: SÁBANA MENSUAL
       */
      function renderSheetView() {
        var y = appState.year;
        var m = appState.month;
        var daysInMonth = new Date(y, m + 1, 0).getDate();
        var cutoff = appState.cutoffDate || DEFAULT_CUTOFF;
        var staffList = getFilteredStaff();

        document.getElementById("bannerMonthYear").textContent = MESES_NOMPROPIO[m] + " " + y;

        var html = "<thead><tr>";
        html += '<th class="sticky-col">Funcionario / Ajuste Rápido</th>';

        for (var d = 1; d <= daysInMonth; d++) {
          var dt = new Date(y, m, d);
          var dISO = formatISO(y, m, d);
          var isWeekend = dt.getDay() === 0 || dt.getDay() === 6;
          var isToday = dISO === cutoff;
          var isFuture = dISO > cutoff;

          var cls = "day-th";
          if (isWeekend) cls += " weekend";
          if (isToday) cls += " is-today";
          else if (isFuture) cls += " is-future";

          var ddStr = d < 10 ? "0" + d : String(d);
          var topTxt = isToday ? "★ HOY" : DIAS_CORTO[dt.getDay()];
          html += '<th class="' + cls + '" title="' + getNompropioDay(y, m, d) + " " + ddStr + "/" + (m + 1) + "/" + y + '">';
          html += '<div class="day-th-name">' + topTxt + "</div>";
          html += '<div class="day-th-num">' + ddStr + "</div>";
          html += "</th>";
        }
        html += "</tr></thead><tbody>";

        for (var i = 0; i < staffList.length; i++) {
          var p = staffList[i];
          var isSup = p.role === "suplente";
          html += "<tr>";
          html += '<td class="sticky-col">';
          html += '<div class="staff-name-row">';
          html += '<span class="staff-name-txt">' + escapeHtml(p.name) + "</span>";
          html += '<span class="role-badge ' + (isSup ? "role-suplente" : "role-titular") + '">' + (isSup ? "Suplente" : "Titular") + "</span>";
          html += "</div>";

          if (!isSup) {
            html += '<div class="inline-controls">';
            html += '<input type="date" class="mini-date" data-inline-date="' + p.id + '" value="' + p.startDate + '" title="Fecha inicio secuencia" />';
            html += '<select class="mini-seed" data-inline-seed="' + p.id + '" title="Semilla inicial">';
            for (var sIdx = 0; sIdx < SEMILLAS_VALIDAS.length; sIdx++) {
              var sd = SEMILLAS_VALIDAS[sIdx];
              html += '<option value="' + sd + '"' + (p.seed === sd ? " selected" : "") + ">" + sd + "</option>";
            }
            html += "</select></div>";
          } else {
            html += '<div style="font-size:11px;color:#6b21a8;margin-top:4px;font-weight:600;">Asignación 100% manual</div>';
          }
          html += "</td>";

          for (var day = 1; day <= daysInMonth; day++) {
            var cellISO = formatISO(y, m, day);
            var cellInfo = getDayCellInfo(p, cellISO);
            var cellCls = "day-cell";
            if (cellISO === cutoff) cellCls += " is-today";
            else if (cellISO > cutoff) cellCls += " is-future";

            html += '<td class="' + cellCls + '" data-cell-staff="' + p.id + '" data-cell-date="' + cellISO + '">';
            html += '<span class="shift-pill ' + cellInfo.pillClass + '">' + cellInfo.badge + "</span>";
            if (cellInfo.subText) {
              html += '<div class="cell-sub">' + escapeHtml(cellInfo.subText) + "</div>";
            }
            html += "</td>";
          }
          html += "</tr>";
        }
        html += "</tbody>";

        document.getElementById("sheetTable").innerHTML = html;
        renderSummaryCards(staffList, y, m, daysInMonth, cutoff);
      }

      function renderSummaryCards(staffList, y, m, daysInMonth, cutoffISO) {
        var monthStart = formatISO(y, m, 1);
        var monthEnd = formatISO(y, m, daysInMonth);

        var periodMode = "CUTOFF"; // CUTOFF | CLOSED | FUTURE
        var effectiveEnd = monthEnd;
        var badgeText = "";
        var badgeCls = "tag-cutoff";

        if (monthEnd < cutoffISO) {
          periodMode = "CLOSED";
          effectiveEnd = monthEnd;
          badgeText = "Cierre mes completo (01 al " + daysInMonth + " " + MESES_NOMPROPIO[m].slice(0, 3) + ")";
          badgeCls = "tag-closed";
        } else if (monthStart > cutoffISO) {
          periodMode = "FUTURE";
          effectiveEnd = monthEnd;
          badgeText = "Proyección mes completo (01 al " + daysInMonth + " " + MESES_NOMPROPIO[m].slice(0, 3) + ")";
          badgeCls = "tag-future";
        } else {
          periodMode = "CUTOFF";
          effectiveEnd = cutoffISO;
          var cp = parseISO(cutoffISO);
          var dCutStr = cp.d < 10 ? "0" + cp.d : String(cp.d);
          badgeText = "A fecha de corte (01 al " + dCutStr + " " + MESES_NOMPROPIO[m].slice(0, 3) + ")";
          badgeCls = "tag-cutoff";
        }

        var cardsHtml = "";
        for (var i = 0; i < staffList.length; i++) {
          var p = staffList[i];
          var isSup = p.role === "suplente";
          var mainStats = calculatePeriodMetrics(p, monthStart, effectiveEnd);
          var fullStats = calculatePeriodMetrics(p, monthStart, monthEnd);

          var fourthLabel = isSup ? "Coberturas" : "Permisos";
          var fourthMain = isSup ? mainStats.suplencias : mainStats.totalNov;

          cardsHtml += '<article class="summary-card">';
          cardsHtml += '<div class="card-top">';
          cardsHtml += '<div>';
          cardsHtml += '<div class="card-title-row">';
          cardsHtml += '<span class="card-name">' + escapeHtml(p.name) + "</span>";
          cardsHtml += '<span class="role-badge ' + (isSup ? "role-suplente" : "role-titular") + '">' + (isSup ? "Suplente" : "Titular") + "</span>";
          cardsHtml += "</div>";
          cardsHtml += '<div class="card-meta">' + (isSup ? "Asignación manual de reemplazos" : "Inicio: " + p.startDate + " • Semilla: " + p.seed) + "</div>";
          cardsHtml += '<span class="card-period-tag ' + badgeCls + '">' + badgeText + "</span>";
          cardsHtml += "</div>";
          cardsHtml += '<button type="button" class="btn btn-ghost" style="padding:6px 10px;font-size:12px;" data-open-nov-staff="' + p.id + '">';
          cardsHtml += (isSup ? "+ Asignar Turno" : "+ Permiso / Ciclo") + "</button>";
          cardsHtml += "</div>";

          cardsHtml += '<div class="metrics-4">';
          cardsHtml += '<div class="metric-box m-d"><div class="metric-lbl">Días (D)</div><div class="metric-val">' + mainStats.cD + "</div></div>";
          cardsHtml += '<div class="metric-box m-n"><div class="metric-lbl">Noches (N)</div><div class="metric-val">' + mainStats.cN + "</div></div>";
          cardsHtml += '<div class="metric-box m-r"><div class="metric-lbl">Desc. (R)</div><div class="metric-val">' + mainStats.cR + "</div></div>";
          cardsHtml += '<div class="metric-box m-p"><div class="metric-lbl">' + fourthLabel + '</div><div class="metric-val">' + fourthMain + "</div></div>";
          cardsHtml += "</div>";

          if (periodMode === "CUTOFF") {
            cardsHtml += '<div class="card-footer-line">';
            cardsHtml += "<span>Proyección mes completo:</span>";
            cardsHtml += "<strong>" + fullStats.cD + " D • " + fullStats.cN + " N • " + fullStats.cR + " R</strong>";
            cardsHtml += "</div>";
          } else {
            cardsHtml += '<div class="card-footer-line">';
            cardsHtml += "<span>Total turnos laborados (D + N):</span>";
            cardsHtml += "<strong>" + mainStats.worked + " turnos</strong>";
            cardsHtml += "</div>";
          }

          cardsHtml += "</article>";
        }

        document.getElementById("summaryCardsGrid").innerHTML = cardsHtml;
      }

      /**
       * RENDERIZADO VISTA 2: 12 MESES
       */
      function renderAnnualView() {
        var y = appState.year;
        var staffList = getFilteredStaff();
        var html = "";

        for (var m = 0; m < 12; m++) {
          var daysInMonth = new Date(y, m + 1, 0).getDate();
          html += '<article class="month-card">';
          html += '<div class="month-card-head">';
          html += '<strong style="font-size:14px;">' + MESES_NOMPROPIO[m] + " " + y + "</strong>";
          html += '<button type="button" class="btn-mini" data-jump-month="' + m + '">Ver sábana →</button>';
          html += "</div><div class='month-card-body'>";

          for (var d = 1; d <= daysInMonth; d++) {
            var dt = new Date(y, m, d);
            var dISO = formatISO(y, m, d);
            var isWk = dt.getDay() === 0 || dt.getDay() === 6;
            var ddStr = d < 10 ? "0" + d : String(d);

            html += '<div class="annual-day-row' + (isWk ? " weekend" : "") + '">';
            html += '<div><strong>' + ddStr + '</strong> <span style="color:' + (isWk ? "#e11d48" : "#475569") + ';">' + getNompropioDay(y, m, d) + "</span></div>";
            html += '<div class="annual-pills">';

            for (var i = 0; i < staffList.length; i++) {
