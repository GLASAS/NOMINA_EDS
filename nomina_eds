      /**
       * MODAL REPORTE NÓMINA (CSV)
       */
      function applyPayrollPreset(preset) {
        var cutoff = appState.cutoffDate || DEFAULT_CUTOFF;
        var cp = parseISO(cutoff);
        var sy = appState.year;
        var sm = appState.month;
        var sISO = cutoff;
        var eISO = cutoff;

        if (preset === "CURRENT_TODAY") {
          sISO = formatISO(cp.y, cp.m, 1);
          eISO = cutoff;
        } else if (preset === "PREV_MONTH") {
          var py = sm === 0 ? sy - 1 : sy;
          var pm = sm === 0 ? 11 : sm - 1;
          var pDays = new Date(py, pm + 1, 0).getDate();
          sISO = formatISO(py, pm, 1);
          eISO = formatISO(py, pm, pDays);
        } else if (preset === "SELECTED_MONTH") {
          var sDays = new Date(sy, sm + 1, 0).getDate();
          sISO = formatISO(sy, sm, 1);
          eISO = formatISO(sy, sm, sDays);
        } else if (preset === "CUTOFF_26_25") {
          var py2 = sm === 0 ? sy - 1 : sy;
          var pm2 = sm === 0 ? 11 : sm - 1;
          sISO = formatISO(py2, pm2, 26);
          eISO = formatISO(sy, sm, 25);
        }

        document.getElementById("payStartInp").value = sISO;
        document.getElementById("payEndInp").value = eISO;

        var btns = document.querySelectorAll(".preset-btn");
        for (var i = 0; i < btns.length; i++) {
          var isMatch = btns[i].getAttribute("data-preset") === preset;
          btns[i].className = "btn preset-btn " + (isMatch ? "btn-sky" : "btn-ghost");
        }

        renderPayrollPreview();
      }

      function buildPayrollData() {
        var sISO = document.getElementById("payStartInp").value || formatISO(appState.year, appState.month, 1);
        var eISO = document.getElementById("payEndInp").value || sISO;
        var filterId = document.getElementById("payStaffSel").value || "ALL";

        var sp = parseISO(sISO);
        var ep = parseISO(eISO);
        var diff = Math.max(0, Math.min(366, diffDaysUTC(ep.y, ep.m, ep.d, sp.y, sp.m, sp.d)));
        var endClamped = addDaysISO(sISO, diff);

        var staffMap = {};
        for (var i = 0; i < appState.staff.length; i++) {
          staffMap[appState.staff[i].id] = appState.staff[i];
        }

        var targetStaff = filterId === "ALL"
          ? appState.staff
          : appState.staff.filter(function (s) { return s.id === filterId; });

        var summaries = [];
        for (var j = 0; j < targetStaff.length; j++) {
          summaries.push({
            person: targetStaff[j],
            metrics: calculatePeriodMetrics(targetStaff[j], sISO, endClamped)
          });
        }

        var novelties = [];
        for (var dOff = 0; dOff <= diff; dOff++) {
          var curISO = addDaysISO(sISO, dOff);
          var cp = parseISO(curISO);
          var dName = getNompropioDay(cp.y, cp.m, cp.d);

          for (var nIdx = 0; nIdx < appState.novelties.length; nIdx++) {
            var nv = appState.novelties[nIdx];
            if (nv.date !== curISO) continue;
            if (filterId !== "ALL" && nv.staffId !== filterId && nv.substituteId !== filterId) continue;

            var pObj = staffMap[nv.staffId];
            if (!pObj) continue;

            if (nv.kind === "ABSENCE") {
              var origShift = getTitularBaseShift(pObj, cp.y, cp.m, cp.d) || "—";
              var supObj = nv.substituteId ? staffMap[nv.substituteId] : null;
              novelties.push({
                date: curISO,
                dayName: dName,
                funcionario: pObj.name,
                baseShift: origShift,
                tipo: nv.type,
                suplente: supObj ? supObj.name + " (" + origShift + ")" : "Sin suplente",
                obs: nv.note || ""
              });
            } else if (nv.kind === "MANUAL_SHIFT" && nv.manualShift !== "LIBRE") {
              var covTit = nv.substituteId ? staffMap[nv.substituteId] : null;
              novelties.push({
                date: curISO,
                dayName: dName,
                funcionario: covTit ? covTit.name : pObj.name,
                baseShift: nv.manualShift,
                tipo: "Turno Manual Suplente",
                suplente: pObj.name + " (" + nv.manualShift + ")",
                obs: nv.note || ""
              });
            } else if (nv.kind === "SHIFT_OVERRIDE") {
              novelties.push({
                date: curISO,
                dayName: dName,
                funcionario: pObj.name,
                baseShift: getTitularBaseShift(pObj, cp.y, cp.m, cp.d) || "—",
                tipo: "Cambio Turno a " + nv.manualShift,
                suplente: "—",
                obs: nv.note || ""
              });
            }
          }
        }

        return {
          startISO: sISO,
          endISO: endClamped,
          daysCount: diff + 1,
          summaries: summaries,
          novelties: novelties
        };
      }

      function renderPayrollPreview() {
        var data = buildPayrollData();
        document.getElementById("payPeriodText").textContent = data.startISO + " al " + data.endISO + " (" + data.daysCount + " días)";
        document.getElementById("payNovCount").textContent = String(data.novelties.length);

        var sHtml = "";
        for (var i = 0; i < data.summaries.length; i++) {
          var row = data.summaries[i];
          var m = row.metrics;
          sHtml += "<tr>";
          sHtml += "<td><strong>" + escapeHtml(row.person.name) + "</strong></td>";
          sHtml += "<td>" + (row.person.role === "titular" ? "Titular" : "Suplente") + "</td>";
          sHtml += "<td>" + m.cD + "</td>";
          sHtml += "<td>" + m.cN + "</td>";
          sHtml += "<td>" + m.cR + "</td>";
          sHtml += "<td><strong>" + m.worked + "</strong></td>";
          sHtml += "<td>" + m.permisos + "</td>";
